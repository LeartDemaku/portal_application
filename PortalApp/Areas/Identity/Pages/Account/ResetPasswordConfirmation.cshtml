@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Fjalëkalimi u ndryshua";
}

<section class="auth">
    <div class="auth-card">
        <span class="brand-mark" aria-hidden="true">ZY</span>
        <h1>Fjalëkalimi u ndryshua</h1>
        <p class="auth-card-intro">Tani mund të kyçeni me fjalëkalimin e ri.</p>
        <div class="auth-form">
            <a class="btn btn-primary btn-block" asp-page="./Login">Kyçu</a>
        </div>
    </div>
</section>

@page
@model LoginModel

@{
    ViewData["Title"] = "Kyçu";
}

<div class="auth-page">
    <div class="container">
        <div class="auth-wrapper">
            <div class="auth-card">
                <div class="auth-card-header">
                    <h2>Mirësevini</h2>
                    <p>Hyni në llogarinë tuaj në PortalX</p>
                </div>
                <div class="auth-card-body">
                    <form id="account" method="post" class="auth-form">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                        
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <label asp-for="Input.Email" class="form-label">Email adresa</label>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>
                        
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                            <label asp-for="Input.Password" class="form-label">Fjalëkalimi</label>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>
                        
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check custom-checkbox">
                                <input class="form-check-input" asp-for="Input.RememberMe" />
                                <label asp-for="Input.RememberMe" class="form-check-label">Mbaj mend</label>
                            </div>
                            <a id="forgot-password" asp-page="./ForgotPassword" class="auth-link">Keni harruar fjalëkalimin?</a>
                        </div>
                        
                        <button id="login-submit" type="submit" class="w-100 primary-button auth-btn">Kyçu në Llogari</button>
                        
                        <div class="mt-4 text-center">
                            <span class="text-muted">Nuk keni llogari?</span>
                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="auth-link ms-1">Regjistrohuni këtu</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@page
@model LoginModel

@{
    ViewData["Title"] = "Kyçu";
}

<section class="auth">
    <div class="auth-card">
        <span class="brand-mark" aria-hidden="true">ZY</span>
        <h1>Mirë se vini</h1>
        <p class="auth-card-intro">Hyni në llogarinë tuaj në ZëriYnë.</p>

        <form id="account" method="post" class="auth-form" novalidate>
            <div asp-validation-summary="ModelOnly" class="form-summary" role="alert"></div>

            <div>
                <div class="field">
                    <input asp-for="Input.Email" type="email" autocomplete="username" aria-required="true" placeholder=" " />
                    <label asp-for="Input.Email">Email-i</label>
                </div>
                <span asp-validation-for="Input.Email" class="field-error"></span>
            </div>

            <div>
                <div class="field">
                    <input asp-for="Input.Password" autocomplete="current-password" aria-required="true" placeholder=" " />
                    <label asp-for="Input.Password">Fjalëkalimi</label>
                </div>
                <span asp-validation-for="Input.Password" class="field-error"></span>
            </div>

            <div class="auth-options">
                <label class="check">
                    <input asp-for="Input.RememberMe" />
                    Më mbaj mend
                </label>
                <a id="forgot-password" asp-page="./ForgotPassword" class="auth-link">Keni harruar fjalëkalimin?</a>
            </div>

            <button id="login-submit" type="submit" class="btn btn-primary btn-block">Kyçu</button>

            <p class="auth-foot">
                Nuk keni llogari?
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="auth-link">Regjistrohuni</a>
            </p>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="~/Views/Shared/Partials/_PortalValidationScripts.cshtml" />
}

@page
@model RegisterModel

@{
    ViewData["Title"] = "Regjistrohu";
}

<section class="auth">
    <div class="auth-card is-wide">
        <span class="brand-mark" aria-hidden="true">ZY</span>
        <h1>Krijo llogarinë</h1>
        <p class="auth-card-intro">Regjistrohuni në ZëriYnë për eksperiencën e plotë.</p>

        <form method="post" class="auth-form" asp-route-returnUrl="@Model.ReturnUrl" novalidate>
            <div asp-validation-summary="ModelOnly" class="form-summary" role="alert"></div>

            <div class="auth-row">
                <div>
                    <div class="field">
                        <input asp-for="Input.FirstName" autocomplete="given-name" placeholder=" " />
                        <label asp-for="Input.FirstName">Emri</label>
                    </div>
                    <span asp-validation-for="Input.FirstName" class="field-error"></span>
                </div>
                <div>
                    <div class="field">
                        <input asp-for="Input.LastName" autocomplete="family-name" placeholder=" " />
                        <label asp-for="Input.LastName">Mbiemri</label>
                    </div>
                    <span asp-validation-for="Input.LastName" class="field-error"></span>
                </div>
            </div>

            <div>
                <div class="field">
                    <input asp-for="Input.Email" type="email" autocomplete="email" placeholder=" " />
                    <label asp-for="Input.Email">Email-i</label>
                </div>
                <span asp-validation-for="Input.Email" class="field-error"></span>
            </div>

            <div class="auth-row">
                <div>
                    <div class="field">
                        <input asp-for="Input.Password" autocomplete="new-password" placeholder=" " />
                        <label asp-for="Input.Password">Fjalëkalimi</label>
                    </div>
                    <span asp-validation-for="Input.Password" class="field-error"></span>
                </div>
                <div>
                    <div class="field">
                        <input asp-for="Input.ConfirmPassword" autocomplete="new-password" placeholder=" " />
                        <label asp-for="Input.ConfirmPassword">Konfirmo fjalëkalimin</label>
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-block">Krijo llogarinë</button>

            <p class="auth-foot">
                Keni tashmë llogari?
                <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="auth-link">Kyçuni</a>
            </p>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="~/Views/Shared/Partials/_PortalValidationScripts.cshtml" />
}

@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Rikthe fjalekalimin";
}

<div class="auth-page">
    <div class="container">
        <div class="auth-wrapper">
            <div class="auth-card">
                <div class="auth-card-header">
                    <h2>Rikthe fjalëkalimin</h2>
                    <p>Krijoni fjalëkalimin tuaj të ri për të aksesuar llogarinë.</p>
                </div>
                <div class="auth-card-body">
                    <form method="post" class="auth-form">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                        <input asp-for="Input.Code" type="hidden" />
                        
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="Ju lutem shkruani email adresen tuaj" />
                            <label asp-for="Input.Email" class="form-label">Email adresa</label>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>
                        
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Ju lutem shkruani fjalekalimin tuaj" />
                            <label asp-for="Input.Password" class="form-label">Fjalëkalimi i ri</label>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>
                        
                        <div class="form-floating mb-4">
                            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Ju lutem konfirmoni fjalekalimin tuaj" />
                            <label asp-for="Input.ConfirmPassword" class="form-label">Konfirmo fjalëkalimin</label>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>
                        
                        <button type="submit" class="w-100 primary-button auth-btn">Ruaj Fjalëkalimin</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

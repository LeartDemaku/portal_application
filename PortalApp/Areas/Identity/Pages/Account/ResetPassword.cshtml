@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Rikthe fjalëkalimin";
}

<section class="auth">
    <div class="auth-card">
        <span class="brand-mark" aria-hidden="true">ZY</span>
        <h1>Fjalëkalim i ri</h1>
        <p class="auth-card-intro">Krijoni fjalëkalimin e ri për llogarinë tuaj.</p>

        <form method="post" class="auth-form" novalidate>
            <div asp-validation-summary="ModelOnly" class="form-summary" role="alert"></div>
            <input asp-for="Input.Code" type="hidden" />

            <div>
                <div class="field">
                    <input asp-for="Input.Email" type="email" autocomplete="username" aria-required="true" placeholder=" " />
                    <label asp-for="Input.Email">Email-i</label>
                </div>
                <span asp-validation-for="Input.Email" class="field-error"></span>
            </div>

            <div>
                <div class="field">
                    <input asp-for="Input.Password" autocomplete="new-password" aria-required="true" placeholder=" " />
                    <label asp-for="Input.Password">Fjalëkalimi i ri</label>
                </div>
                <span asp-validation-for="Input.Password" class="field-error"></span>
            </div>

            <div>
                <div class="field">
                    <input asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" placeholder=" " />
                    <label asp-for="Input.ConfirmPassword">Konfirmo fjalëkalimin</label>
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-block">Ruaj fjalëkalimin</button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="~/Views/Shared/Partials/_PortalValidationScripts.cshtml" />
}

@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Keni harruar fjalëkalimin?";
}

<section class="auth">
    <div class="auth-card">
        <span class="brand-mark" aria-hidden="true">ZY</span>
        <h1>Keni harruar fjalëkalimin?</h1>
        <p class="auth-card-intro">Shkruani email-in tuaj dhe do t'ju dërgojmë një link për të krijuar një fjalëkalim të ri.</p>

        <form id="account" method="post" class="auth-form" novalidate>
            <div asp-validation-summary="ModelOnly" class="form-summary" role="alert"></div>

            <div>
                <div class="field">
                    <input asp-for="Input.Email" type="email" autocomplete="username" aria-required="true" placeholder=" " />
                    <label asp-for="Input.Email">Email-i</label>
                </div>
                <span asp-validation-for="Input.Email" class="field-error"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-block">Dërgo linkun</button>

            <p class="auth-foot">
                <a asp-page="./Login" class="auth-link">Kthehu te kyçja</a>
            </p>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="~/Views/Shared/Partials/_PortalValidationScripts.cshtml" />
}

@using Microsoft.AspNetCore.Identity
@using PortalApp.Models.ViewModels
@model UserStoreViewModel

@{
    Layout = "~/Views/Shared/Admin/_Layout.cshtml";
    ViewData["Title"] = "Krijo përdorues";
    var roles = ViewBag.Roles as List<IdentityRole> ?? new List<IdentityRole>();
}

<div class="admin-card" style="max-width:700px;">
    <form asp-action="Create" asp-controller="AdminUser" method="post" class="admin-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="admin-form-grid">
            <div class="admin-form-main">
                <div class="form-field">
                    <label asp-for="FirstName">Emri</label>
                    <input asp-for="FirstName" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="LastName">Mbiemri</label>
                    <input asp-for="LastName" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Email">Email</label>
                    <input asp-for="Email" type="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Password">Fjalëkalimi</label>
                    <input asp-for="Password" type="password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="RoleId">Roli</label>
                    <select asp-for="RoleId">
                        <option value="">Zgjidh rolin</option>
                        @foreach (var role in roles)
                        {
                            <option value="@role.Id">@role.Name</option>
                        }
                    </select>
                    <span asp-validation-for="RoleId" class="text-danger"></span>
                </div>

                <div class="admin-form-actions">
                    <button type="submit" class="primary-button">Ruaj përdoruesin</button>
                    <a asp-action="Index" asp-controller="AdminUser" class="secondary-button">Anulo</a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

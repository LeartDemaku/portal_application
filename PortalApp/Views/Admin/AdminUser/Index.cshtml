@using Microsoft.AspNetCore.Identity
@model List<ApplicationUserViewModel>

@{
    Layout = "~/Views/Shared/Admin/_Layout.cshtml";
    ViewData["Title"] = "Përdoruesit";
}

<div class="admin-card">
    <div class="admin-toolbar">
        <div>
            <span class="eyebrow">Menaxhim</span>
            <h2>Lista e përdoruesve</h2>
        </div>
        <a asp-action="Create" asp-controller="AdminUser" class="primary-button">Krijo përdorues</a>
    </div>

    <div class="table-responsive">
        <table class="table admin-table align-middle">
            <thead>
                <tr>
                    <th>Emri</th>
                    <th>Email</th>
                    <th>Roli</th>
                    <th class="text-end">Veprime</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="table-title-cell">
                                    <strong>@(string.Concat(item.FirstName, " ", item.LastName).Trim())</strong>
                                </div>
                            </td>
                            <td>@item.Email</td>
                            <td>
                                <span class="status-pill live">@(item.Roles.FirstOrDefault() ?? "-")</span>
                            </td>
                            <td class="text-end">
                                <div class="table-actions">
                                    <a asp-action="Edit" asp-controller="AdminUser" asp-route-id="@item.Id" class="secondary-button">Edito</a>
                                    <form asp-action="Delete" asp-controller="AdminUser" asp-route-id="@item.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="danger-button" onclick="return confirm('A dëshironi ta fshini përdoruesin?');">Fshij</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4">
                            <div class="empty-state small">
                                <h3>Nuk ka përdorues për shfaqje</h3>
                                <p>Krijoni përdoruesin e parë të sistemit.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@using Microsoft.AspNetCore.Identity
@using PortalApp.Models.ViewModels
@model UserStoreViewModel

@{
    Layout = "~/Views/Shared/Admin/_Layout.cshtml";
    ViewData["Title"] = "Edito përdoruesin";
    var roles = ViewBag.Roles as List<IdentityRole> ?? new List<IdentityRole>();
    var userId = ViewBag.UserId as string ?? string.Empty;
    var currentRoleId = ViewBag.CurrentRoleId as string ?? Model.RoleId;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h3 class="mb-4">Edito përdoruesin</h3>

                    <form asp-action="Edit" asp-controller="AdminUser" asp-route-id="@userId" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label">Emri</label>
                                <input asp-for="FirstName" class="form-control" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label">Mbiemri</label>
                                <input asp-for="LastName" class="form-control" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" type="email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Fjalëkalimi i ri</label>
                            <input asp-for="Password" type="password" class="form-control" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="RoleId" class="form-label">Roli</label>
                            <select asp-for="RoleId" class="form-select">
                                <option value="">Zgjidh rolin</option>
                                @foreach (var role in roles)
                                {
                                    <option value="@role.Id" selected="@(currentRoleId == role.Id)">@role.Name</option>
                                }
                            </select>
                            <span asp-validation-for="RoleId" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Ruaj</button>
                            <a asp-action="Index" asp-controller="AdminUser" class="btn btn-outline-secondary">Anulo</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}

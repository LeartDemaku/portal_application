@model PortalApp.Models.ArticleTag

@{
    Layout = "~/Views/Shared/Admin/_Layout.cshtml";
    ViewData["Title"] = "Krijo tag";
}

<div class="admin-card" style="max-width:600px;">
    <form asp-action="Create" asp-controller="AdminArticleTag" method="post" class="admin-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-field">
            <label asp-for="Title">Emri i tagut</label>
            <input asp-for="Title" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="admin-form-actions">
            <button type="submit" class="primary-button">Ruaj tagun</button>
            <a asp-action="Index" asp-controller="AdminArticleTag" class="secondary-button">Anulo</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

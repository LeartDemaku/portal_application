@model IEnumerable<PortalApp.Models.ArticleTag>

@{
    Layout = "~/Views/Shared/Admin/_Layout.cshtml";
    ViewData["Title"] = "Tagjet";
}

<div class="admin-card">
    <div class="admin-toolbar">
        <div>
            <span class="eyebrow">Menaxhim</span>
            <h2>Lista e tageve</h2>
        </div>
        <a asp-action="Create" asp-controller="AdminArticleTag" class="primary-button">Shto tag</a>
    </div>

    <div class="table-responsive">
        <table class="table admin-table align-middle">
            <thead>
                <tr>
                    <th>Titulli</th>
                    <th>Krijuar më</th>
                    <th class="text-end">Veprime</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var tag in Model)
                    {
                        <tr>
                            <td><strong>#@tag.Title</strong></td>
                            <td>@tag.CreatedAt.ToString("dd.MM.yyyy")</td>
                            <td class="text-end">
                                <div class="table-actions">
                                    <form asp-action="Delete" asp-controller="AdminArticleTag" asp-route-id="@tag.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="danger-button" onclick="return confirm('A dëshironi ta fshini tagun?');">Fshij</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3">
                            <div class="empty-state small">
                                <h3>Nuk ka tagje për shfaqje</h3>
                                <p>Krijoni tagun e parë për të etiketuar artikujt.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

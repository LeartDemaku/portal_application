@model IEnumerable<PortalApp.Models.ArticleTag>

@{
    Layout = "~/Views/Shared/Admin/_Layout.cshtml";
    ViewData["Title"] = "Tagjet";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Tagjet</h2>
        <a asp-action="Create" asp-controller="AdminArticleTag" class="btn btn-success">Shto tag</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Titulli</th>
                    <th>Krijuar më</th>
                    <th class="text-end">Veprime</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var tag in Model)
                    {
                        <tr>
                            <td>@tag.Id</td>
                            <td>@tag.Title</td>
                            <td>@tag.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td class="text-end">
                                <form asp-action="Delete" asp-controller="AdminArticleTag" asp-route-id="@tag.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('A dëshironi ta fshini tagun?');">Fshij</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">Nuk ka tagje për t'u shfaqur.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

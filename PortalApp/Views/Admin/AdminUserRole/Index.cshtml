@using Microsoft.AspNetCore.Identity
@model List<IdentityRole>

@{
    Layout = "~/Views/Shared/Admin/_Layout.cshtml";
    ViewData["Title"] = "Rolet";
}

<div class="admin-card">
    <div class="admin-toolbar">
        <div>
            <span class="eyebrow">Menaxhim</span>
            <h2>Lista e roleve</h2>
        </div>
        <a asp-action="Create" asp-controller="AdminUserRole" class="primary-button">Krijo rol</a>
    </div>

    <div class="table-responsive">
        <table class="table admin-table align-middle">
            <thead>
                <tr>
                    <th>Emri i rolit</th>
                    <th class="text-end">Veprime</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.Name</strong></td>
                            <td class="text-end">
                                <div class="table-actions">
                                    <a asp-action="Edit" asp-controller="AdminUserRole" asp-route-id="@item.Id" class="secondary-button">Edito</a>
                                    <form asp-action="Delete" asp-controller="AdminUserRole" asp-route-id="@item.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="danger-button" onclick="return confirm('A dëshironi ta fshini rolin?');">Fshij</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="2">
                            <div class="empty-state small">
                                <h3>Nuk ka role për shfaqje</h3>
                                <p>Krijoni rolin e parë të sistemit.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

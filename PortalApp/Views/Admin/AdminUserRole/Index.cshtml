@using Microsoft.AspNetCore.Identity
@model List<IdentityRole>

@{
    Layout = "~/Views/Shared/Admin/_Layout.cshtml";
    ViewData["Title"] = "Rolet";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Rolet</h2>
        <a asp-action="Create" asp-controller="AdminUserRole" class="btn btn-success">Krijo rol</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Emri i rolit</th>
                    <th class="text-end">Veprimi</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model.Select((value, i) => new { value, i }))
                    {
                        <tr>
                            <td>@(item.i + 1)</td>
                            <td>@item.value.Name</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-controller="AdminUserRole" asp-route-id="@item.value.Id" class="btn btn-outline-primary btn-sm">Edito</a>
                                <form asp-action="Delete" asp-controller="AdminUserRole" asp-route-id="@item.value.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('A dëshironi ta fshini rolin?');">Fshij</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted py-4">Nuk ka role për t'u shfaqur.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@using PortalApp.Models.ViewModels
@model UserRoleStoreViewModel

@{
    Layout = "~/Views/Shared/Admin/_Layout.cshtml";
    ViewData["Title"] = "Edito rolin";
    var roleId = ViewBag.RoleId as string ?? string.Empty;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h3 class="mb-4">Edito rolin</h3>

                    <form asp-action="Edit" asp-controller="AdminUserRole" asp-route-id="@roleId" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="RoleName" class="form-label">Emri i rolit</label>
                            <input asp-for="RoleName" class="form-control" />
                            <span asp-validation-for="RoleName" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Ruaj</button>
                            <a asp-action="Index" asp-controller="AdminUserRole" class="btn btn-outline-secondary">Anulo</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}

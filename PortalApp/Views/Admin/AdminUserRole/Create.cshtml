@using PortalApp.Models.ViewModels
@model UserRoleStoreViewModel

@{
    Layout = "~/Views/Shared/Admin/_Layout.cshtml";
    ViewData["Title"] = "Krijo rol";
}

<div class="admin-card" style="max-width:600px;">
    <form asp-action="Create" asp-controller="AdminUserRole" method="post" class="admin-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-field">
            <label asp-for="RoleName">Emri i rolit</label>
            <input asp-for="RoleName" />
            <span asp-validation-for="RoleName" class="text-danger"></span>
        </div>

        <div class="admin-form-actions">
            <button type="submit" class="primary-button">Ruaj rolin</button>
            <a asp-action="Index" asp-controller="AdminUserRole" class="secondary-button">Anulo</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

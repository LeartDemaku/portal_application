@using PortalApp.Models.ViewModels
@model UserRoleStoreViewModel

@{
    Layout = "~/Views/Shared/Admin/_Layout.cshtml";
    ViewData["Title"] = "Krijo rol";
    ViewData["Subtitle"] = "Përcakto një nivel të ri aksesi për ekipin editorial dhe administrativ.";
}

<a asp-action="Index" asp-controller="AdminUserRole" class="admin-page-back">
    <svg class="admin-icon" aria-hidden="true"><use href="#i-arrow-left"></use></svg>
    Kthehu te rolet
</a>

<div class="admin-form-layout admin-form-layout--narrow">
    <section class="admin-form-card">
        <div class="admin-form-card-head">
            <span class="admin-form-card-icon admin-form-card-icon--violet">
                <svg class="admin-icon" aria-hidden="true"><use href="#i-shield"></use></svg>
            </span>
            <div class="admin-form-card-title">
                <h2>Detajet e rolit</h2>
                <p>Emri i rolit shfaqet gjatë krijimit dhe redaktimit të përdoruesve.</p>
            </div>
        </div>
        <form asp-action="Create" asp-controller="AdminUserRole" method="post" class="admin-form" data-admin-form>
            @Html.AntiForgeryToken()
            <div class="admin-form-card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-field">
                    <label asp-for="RoleName">
                        <span>Emri i rolit</span>
                        <span class="field-optional">I detyrueshëm</span>
                    </label>
                    <input asp-for="RoleName" placeholder="P.sh. Korrektor, Fotograf, Analist" autocomplete="off" />
                    <span asp-validation-for="RoleName" class="text-danger"></span>
                    <span class="field-hint">Përdor një emër të qartë që përshkruan përgjegjësinë kryesore.</span>
                </div>
                <div class="admin-section-divider">Sugjerime</div>
                <div class="admin-suggestion-list">
                    <button type="button" class="admin-suggestion" data-fill-target="RoleName" data-fill-value="Redaktor">Redaktor</button>
                    <button type="button" class="admin-suggestion" data-fill-target="RoleName" data-fill-value="Gazetar">Gazetar</button>
                    <button type="button" class="admin-suggestion" data-fill-target="RoleName" data-fill-value="Korrektor">Korrektor</button>
                    <button type="button" class="admin-suggestion" data-fill-target="RoleName" data-fill-value="Fotograf">Fotograf</button>
                    <button type="button" class="admin-suggestion" data-fill-target="RoleName" data-fill-value="Analist">Analist</button>
                </div>
            </div>
            <div class="admin-form-card-foot">
                <a asp-action="Index" asp-controller="AdminUserRole" class="admin-btn admin-btn--ghost">Anulo</a>
                <button type="submit" class="admin-btn admin-btn--primary">
                    <svg class="admin-icon" aria-hidden="true"><use href="#i-check"></use></svg>
                    Ruaj rolin
                </button>
            </div>
        </form>
    </section>

    <aside class="admin-editor-side">
        <div class="admin-tip-card">
            <span class="admin-tip-icon"><svg class="admin-icon" aria-hidden="true"><use href="#i-sparkles"></use></svg></span>
            <h3>Role të dobishme</h3>
            <p>Roli duhet të përshkruajë detyrën, jo personin. Kështu mbetet i dobishëm edhe kur ekipi ndryshon.</p>
            <ul class="admin-tip-list">
                <li><svg class="admin-icon" aria-hidden="true"><use href="#i-check"></use></svg>Përdor emra në njëjës.</li>
                <li><svg class="admin-icon" aria-hidden="true"><use href="#i-check"></use></svg>Shmang role me dallime të vogla.</li>
                <li><svg class="admin-icon" aria-hidden="true"><use href="#i-check"></use></svg>Dokumento qëllimin e rolit.</li>
            </ul>
        </div>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

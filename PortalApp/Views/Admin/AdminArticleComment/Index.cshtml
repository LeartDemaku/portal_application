@model IEnumerable<PortalApp.Models.ArticleComment>

@{
    Layout = "~/Views/Shared/Admin/_Layout.cshtml";
    ViewData["Title"] = "Komentet";
}

<div class="admin-card">
    <div class="admin-toolbar">
        <div>
            <span class="eyebrow">Menaxhim</span>
            <h2>Lista e komenteve</h2>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table admin-table align-middle">
            <thead>
                <tr>
                    <th>Autori</th>
                    <th>Komenti</th>
                    <th>Artikulli</th>
                    <th>Data</th>
                    <th class="text-end">Veprime</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.Name</strong></td>
                            <td>@(item.Comment.Length > 80 ? item.Comment[..80] + "..." : item.Comment)</td>
                            <td>@item.Article?.Title</td>
                            <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="text-end">
                                <div class="table-actions">
                                    <form asp-action="Delete" asp-controller="AdminArticleComment" asp-route-id="@item.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="danger-button" onclick="return confirm('A dëshironi ta fshini komentin?');">Fshij</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5">
                            <div class="empty-state small">
                                <h3>Nuk ka komente për shfaqje</h3>
                                <p>Komentet e lexuesve do të shfaqen këtu.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@model IEnumerable<PortalApp.Models.ArticleCategory>

@{
    Layout = "~/Views/Shared/Admin/_Layout.cshtml";
    ViewData["Title"] = "Kategoritë";
}

<div class="admin-card">
    <div class="admin-toolbar">
        <div>
            <span class="eyebrow">Menaxhim</span>
            <h2>Lista e kategorive</h2>
        </div>
        <a asp-action="Create" asp-controller="AdminArticleCategory" class="primary-button">Shto kategori</a>
    </div>

    <div class="table-responsive">
        <table class="table admin-table align-middle">
            <thead>
                <tr>
                    <th>Emri</th>
                    <th>Krijuar më</th>
                    <th class="text-end">Veprime</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.Name</strong></td>
                            <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="text-end">
                                <div class="table-actions">
                                    <a asp-action="Edit" asp-controller="AdminArticleCategory" asp-route-id="@item.Id" class="secondary-button">Edito</a>
                                    <form asp-action="Delete" asp-controller="AdminArticleCategory" asp-route-id="@item.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="danger-button" onclick="return confirm('A dëshironi ta fshini kategorinë?');">Fshij</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3">
                            <div class="empty-state small">
                                <h3>Nuk ka kategori për shfaqje</h3>
                                <p>Krijoni kategorinë e parë për të organizuar lajmet.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@model PortalApp.Models.ArticleCategory

@{
    Layout = "~/Views/Shared/Admin/_Layout.cshtml";
    ViewData["Title"] = "Edito kategorinë";
}

<div class="admin-card" style="max-width:600px;">
    <form asp-action="Edit" asp-controller="AdminArticleCategory" asp-route-id="@Model.Id" method="post" class="admin-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-field">
            <label asp-for="Name">Emri i kategorisë</label>
            <input asp-for="Name" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="admin-form-actions">
            <button type="submit" class="primary-button">Ruaj ndryshimet</button>
            <a asp-action="Index" asp-controller="AdminArticleCategory" class="secondary-button">Anulo</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

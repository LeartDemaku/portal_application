@using PortalApp.Models
@using PortalApp.Models.ViewModels
@model ArticleEditViewModel

@{
    Layout = "~/Views/Shared/Admin/_Layout.cshtml";
    ViewData["Title"] = "Edito artikullin";
    var categories = ViewBag.ArticleCategories as List<ArticleCategory> ?? new List<ArticleCategory>();
    var tags = ViewBag.ArticleTags as List<ArticleTag> ?? new List<ArticleTag>();
    var users = ViewBag.Users as List<ApplicationUser> ?? new List<ApplicationUser>();
    var canManageCreator = ViewBag.CanManageCreator is true;
    var canApprove = ViewBag.CanApprove is true;
}

@section Styles
{
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet" />
}

<div class="admin-card">
    <form asp-action="Edit" asp-route-id="@Context.Request.RouteValues["id"]" method="post" enctype="multipart/form-data" class="admin-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="admin-form-grid">
            <div class="admin-form-main">
                <div class="form-field">
                    <label asp-for="Title">Titulli</label>
                    <input asp-for="Title" placeholder="Shkruaj titullin e artikullit..." />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Content">Përmbajtja</label>
                    <div id="editor-container" style="min-height: 300px; background: #ffffff; color: #0f172a; border-radius: 0.75rem; font-size: 1rem;">@Html.Raw(Model?.Content)</div>
                    <input type="hidden" asp-for="Content" id="ContentInput" />
                    <span asp-validation-for="Content" class="text-danger"></span>
                </div>
            </div>

            <aside class="admin-form-side">
                @if (!string.IsNullOrWhiteSpace(Model?.CurrentCoverImage))
                {
                    <div class="image-preview-card">
                        <span class="eyebrow">Imazhi aktual</span>
                        <img src="~/images/articles/@Model.CurrentCoverImage" alt="Imazhi aktual" />
                    </div>
                }

                <div class="form-field">
                    <label asp-for="ArticleCategoryId">Kategoria</label>
                    <select asp-for="ArticleCategoryId">
                        <option value="0">Zgjidh kategorine</option>
                        @foreach (var category in categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </select>
                    <span asp-validation-for="ArticleCategoryId" class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="ArticleTags">Tagjet</label>
                    <select asp-for="ArticleTags" class="select2" multiple>
                        @foreach (var tag in tags)
                        {
                            var isSelected = Model?.ArticleTags != null && Model.ArticleTags.Contains(tag.Title, StringComparer.OrdinalIgnoreCase);
                            <option value="@tag.Title" selected="@isSelected">@tag.Title</option>
                        }

                        @if (Model?.ArticleTags != null)
                        {
                            @foreach (var tag in Model.ArticleTags.Where(x => !tags.Any(t => t.Title.Equals(x, StringComparison.OrdinalIgnoreCase))))
                            {
                                <option value="@tag" selected="selected">@tag</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="ArticleTags" class="text-danger"></span>
                </div>

                @if (canManageCreator)
                {
                    <div class="form-field">
                        <label asp-for="CreatedBy">Autori</label>
                        <select asp-for="CreatedBy">
                            <option value="">Zgjidh autorin</option>
                            @foreach (var user in users)
                            {
                                var fullName = string.Join(" ", new[] { user.FirstName, user.LastName }.Where(x => !string.IsNullOrWhiteSpace(x)));
                                <option value="@user.Id">@((string.IsNullOrWhiteSpace(fullName) ? user.Email : fullName))</option>
                            }
                        </select>
                        <span asp-validation-for="CreatedBy" class="text-danger"></span>
                    </div>
                }

                @if (canApprove)
                {
                    <label class="toggle-field">
                        <input asp-for="IsApproved" />
                        <span>Artikulli eshte i publikuar</span>
                    </label>
                }

                <div class="form-field">
                    <label asp-for="CoverImage">Nderro imazhin</label>
                    <input asp-for="CoverImage" type="file" accept="image/*" />
                    <span asp-validation-for="CoverImage" class="text-danger"></span>
                </div>

                <div class="admin-form-actions">
                    <button type="submit" class="primary-button">Ruaj ndryshimet</button>
                    <a asp-action="Index" asp-controller="AdminArticle" class="secondary-button">Anulo</a>
                </div>
            </aside>
        </div>
    </form>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
    <script>
        $(function () {
            $('.select2').select2({
                tags: true,
                width: '100%',
                placeholder: 'Zgjidh ose shkruaj tagjet'
            });

            var quill = new Quill('#editor-container', {
                theme: 'snow',
                placeholder: 'Shkruaj përmbajtjen e artikullit këtu...',
                modules: {
                    toolbar: [
                        [{ 'header': [1, 2, 3, false] }],
                        ['bold', 'italic', 'underline', 'strike'],
                        [{ 'color': [] }, { 'background': [] }],
                        [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                        ['link'],
                        ['clean']
                    ]
                }
            });

            $('form').on('submit', function () {
                var html = quill.root.innerHTML;
                if (html === '<p><br></p>') {
                    html = '';
                }
                $('#ContentInput').val(html);
            });
        });
    </script>
}

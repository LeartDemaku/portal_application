@model ErrorViewModel
@{
    ViewData["Title"] = "Diçka shkoi keq";
}

<div class="container">
    <section class="status-page">
        <span class="status-code" aria-hidden="true">500</span>
        <h1>Diçka shkoi keq</h1>
        <p>Ndodhi një gabim gjatë hapjes së kësaj faqeje. Provoni përsëri pas pak çastesh.</p>
        @if (Model?.ShowRequestId == true)
        {
            <p>Kodi i kërkesës: <code>@Model.RequestId</code></p>
        }
        <div class="status-actions">
            <a class="btn btn-primary" asp-area="" asp-controller="Home" asp-action="Index">Kthehu në ballinë</a>
            <a class="btn btn-ghost" asp-area="" asp-controller="Home" asp-action="Search">Kërko në portal</a>
        </div>
    </section>
</div>

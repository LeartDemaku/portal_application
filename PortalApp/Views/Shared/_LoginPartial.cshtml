@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@{
    // "drawer" = versioni për menynë anësore në telefon; pa vlerë = versioni i header-it
    var isDrawer = ViewData["Variant"] as string == "drawer";
    var wrapperClass = isDrawer ? "drawer-account" : "account-actions";
    var userName = User.Identity?.Name ?? string.Empty;
    var initial = string.IsNullOrWhiteSpace(userName) ? "?" : userName[..1];
    // Linku i panelit shfaqet vetëm për stafin e redaksisë, jo për lexuesit e regjistruar
    var staffRoles = new[] { "Drejtor", "Admin", "Administrator", "Gazetar", "Redaktor" };
    var isStaff = staffRoles.Any(User.IsInRole);
}

<div class="@wrapperClass">
    @if (SignInManager.IsSignedIn(User))
    {
        <span class="account-user" title="@userName">
            <span class="avatar" aria-hidden="true">@initial</span>
            <span>@userName</span>
        </span>
        @if (isStaff)
        {
            <a class="btn btn-ghost" href="/Admin/AdminArticle/Index">
                <svg class="icon icon-sm"><use href="#i-grid" /></svg> Paneli
            </a>
        }
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
            <button type="submit" class="btn btn-ghost @(isDrawer ? "btn-block" : null)" aria-label="Dil nga llogaria">
                <svg class="icon icon-sm"><use href="#i-logout" /></svg> Dil
            </button>
        </form>
    }
    else
    {
        <a class="btn btn-ghost" asp-area="Identity" asp-page="/Account/Register">Regjistrohu</a>
        <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Login">Hyr</a>
    }
</div>

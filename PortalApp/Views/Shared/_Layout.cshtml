@using PortalApp.Services
@inject IPortalQueryService PortalQueryService
@{
    var sections = await PortalQueryService.GetNavigationItemsAsync();
    var currentPath = Context.Request.Path.Value ?? "/";
}
<!DOCTYPE html>
<html lang="sq">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ZëriYnë</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PortalApp.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="portal-body">
    <header class="site-header" data-site-header>
        <div class="site-topbar">
            <div class="container site-topbar-inner">
                <div class="topbar-left">
                    <span class="topbar-edition">Edicioni Digjital</span>
                </div>
                <div class="topbar-right">
                    <span class="topbar-date">@DateTime.Now.ToString("dd MMMM yyyy")</span>
                </div>
            </div>
        </div>
        <nav class="navbar navbar-expand-lg portal-navbar" id="main-navbar">
            <div class="container">
                <a class="navbar-brand portal-brand" asp-controller="Home" asp-action="Index">
                    <span class="portal-brand-mark">
                        <span class="brand-mark-text">ZY</span>
                        <span class="brand-mark-glow"></span>
                    </span>
                    <span class="portal-brand-copy">
                        <strong class="brand-name">ZëriYnë</strong>
                        <small class="brand-tagline">Jehona e së vërtetës</small>
                    </span>
                </a>

                <button class="navbar-toggler portal-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#portalNavbarNav" aria-controls="portalNavbarNav" aria-expanded="false" aria-label="Hap menunë">
                    <span class="toggler-bar"></span>
                    <span class="toggler-bar"></span>
                    <span class="toggler-bar"></span>
                </button>

                <div class="collapse navbar-collapse" id="portalNavbarNav">
                    <ul class="navbar-nav portal-nav-links me-auto">
                        <li class="nav-item">
                            <a class="nav-link @(currentPath == "/" ? "active" : null)" asp-controller="Home" asp-action="Index">Ballina</a>
                        </li>
                        @foreach (var navSection in sections)
                        {
                            var sectionPath = $"/kategori/{navSection.Slug}";
                            <li class="nav-item">
                                <a class="nav-link @(currentPath.StartsWith(sectionPath, StringComparison.OrdinalIgnoreCase) || currentPath.Equals($"/{navSection.Slug}", StringComparison.OrdinalIgnoreCase) ? "active" : null)" asp-controller="Sections" asp-action="Show" asp-route-slug="@navSection.Slug">@navSection.Title</a>
                            </li>
                        }
                    </ul>

                    <div class="portal-actions">
                        <form class="portal-search" asp-controller="Home" asp-action="Search" method="get">
                            <svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                                <circle cx="11" cy="11" r="8"/>
                                <path d="m21 21-4.35-4.35"/>
                            </svg>
                            <input type="search" name="q" value="@Context.Request.Query["q"]" placeholder="Kërko..." aria-label="Kërko" />
                            <button type="submit" aria-label="Kërko">Kërko</button>
                        </form>
                        <div class="portal-auth">
                            <partial name="_LoginPartial" />
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="site-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="site-footer-grid">
                <div>
                    <p class="site-footer-title">ZëriYnë</p>
                    <p class="site-footer-copy">Platformë editoriale me fokus të qartë në ekonomi, teknologji, sport, shëndetësi, politikë dhe zhvillime globale.</p>
                </div>
                <div>
                    <p class="site-footer-title">Navigimi</p>
                    <div class="site-footer-links">
                        <a asp-controller="Home" asp-action="Index">Ballina</a>
                        <a asp-controller="Home" asp-action="Search">Kërko</a>
                        <a asp-controller="Home" asp-action="Privacy">Privatësia</a>
                    </div>
                </div>
                <div>
                    <p class="site-footer-title">Redaksia</p>
                    <p class="site-footer-copy">Publikim i shpejtë, i strukturuar dhe i përshtatur për çdo pajisje.</p>
                </div>
            </div>
            <div class="site-footer-bottom">
                <p>&copy; @DateTime.Now.Year ZëriYnë. Të gjitha të drejtat e rezervuara.</p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

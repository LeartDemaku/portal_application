@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
<!DOCTYPE html>
<html lang="sq">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PortalX Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PortalApp.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-body">
    <div class="admin-shell">
        <aside class="admin-sidebar">
            <a class="admin-brand" asp-controller="AdminArticle" asp-action="Index">
                <span class="portal-brand-mark">PX</span>
                <span>
                    <strong>PortalX Admin</strong>
                    <small>Kontrolli editorial</small>
                </span>
            </a>
            <nav class="admin-nav">
                <a asp-controller="Home" asp-action="Index">Shiko portalin</a>
                <a asp-controller="AdminArticle" asp-action="Index">Artikujt</a>
                <a asp-controller="AdminArticleCategory" asp-action="Index">Kategorite</a>
                <a asp-controller="AdminArticleTag" asp-action="Index">Tagjet</a>
                <a asp-controller="AdminArticleComment" asp-action="Index">Komentet</a>
                <a asp-controller="AdminUser" asp-action="Index">Perdoruesit</a>
                <a asp-controller="AdminUserRole" asp-action="Index">Rolet</a>
            </nav>
        </aside>
        <div class="admin-content">
            <header class="admin-topbar">
                <div>
                    <p class="admin-eyebrow">Panel editorial</p>
                    <h1>@ViewData["Title"]</h1>
                </div>
                <partial name="_LoginPartial" />
            </header>
            <main class="admin-main">
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

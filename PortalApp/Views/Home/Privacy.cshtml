@{
    ViewData["Title"] = "Privatësia";
    ViewData["Description"] = "Si i përdor ZëriYnë të dhënat e lexuesve.";
}

<div class="page">
    <div class="container">
        <article class="page-card">
            <span class="eyebrow">Informacion</span>
            <h1>Politika e privatësisë</h1>
            <p class="article-lede">ZëriYnë respekton privatësinë e lexuesve dhe redaktorëve të saj.</p>
            <div class="prose">
                <h2>Komentet</h2>
                <p>Kur komentoni, ruajmë emrin, email-in dhe tekstin e komentit. Emri dhe komenti shfaqen publikisht; email-i nuk publikohet.</p>
                <h2>Llogaritë</h2>
                <p>Nëse krijoni llogari, ruajmë emrin, mbiemrin dhe email-in tuaj. Fjalëkalimi ruhet vetëm në formë të enkriptuar (hash).</p>
                <h2>Cookies dhe preferencat</h2>
                <p>Përdorim cookies të domosdoshme për kyçjen dhe për mbrojtjen e formularëve. Zgjedhja juaj për light ose dark mode ruhet vetëm në shfletuesin tuaj.</p>
            </div>
        </article>
    </div>
</div>

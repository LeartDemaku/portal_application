@model ArticleComment
@{
    var initial = string.IsNullOrWhiteSpace(Model.Name) ? "?" : Model.Name.Trim()[..1];
}

<article class="comment">
    <span class="avatar" aria-hidden="true">@initial</span>
    <div>
        <div class="comment-head">
            <strong>@Model.Name</strong>
            <time datetime="@Model.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ss")" data-relative>@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</time>
        </div>
        <p>@Model.Comment</p>
    </div>
</article>

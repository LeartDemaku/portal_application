@model PortalArticleCardViewModel
@{
    var accent = PortalApp.Services.PortalSectionRegistry.Resolve(Model.CategoryName).AccentColor;
    var isWide = ViewData["Wide"] as bool? == true;
}

<article class="story-card @(isWide ? "is-wide" : null)" style="--accent:@accent" data-reveal>
    <div class="story-card-media">
        <img src="@Model.CoverImageUrl" alt="" loading="lazy" decoding="async" />
        <a class="chip chip-solid" asp-controller="Sections" asp-action="Show" asp-route-slug="@Model.CategorySlug">@Model.CategoryName</a>
    </div>
    <div class="story-card-body">
        <h3 class="story-card-title">
            <a asp-controller="Home" asp-action="Show" asp-route-id="@Model.Id">@Model.Title</a>
        </h3>
        <p class="story-card-summary">@Model.Summary</p>
        @if (Model.Tags.Any())
        {
            <div class="story-card-tags">
                @foreach (var tag in Model.Tags)
                {
                    <a asp-controller="Tag" asp-action="Show" asp-route-name="@tag">#@tag</a>
                }
            </div>
        }
        <div class="story-card-footer">
            <div class="meta">
                <strong>@Model.AuthorName</strong>
                <time class="meta-dot" datetime="@Model.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ss")" data-relative>@Model.CreatedAt.ToString("dd.MM.yyyy")</time>
                <span class="meta-dot">@Model.ReadTimeMinutes min lexim</span>
            </div>
        </div>
    </div>
</article>

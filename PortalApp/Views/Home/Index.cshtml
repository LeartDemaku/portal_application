@model PortalHomeViewModel
@{
    ViewData["Title"] = "Ballina";
}

<div class="portal-page">
    <div class="container">
        @if (Model.FeaturedArticle != null)
        {
            <section class="hero-grid">
                <article class="hero-card premium-hero">
                    <a class="premium-hero-cover-link" asp-controller="Home" asp-action="Show" asp-route-id="@Model.FeaturedArticle.Id">
                        <img class="premium-hero-img" src="@Model.FeaturedArticle.CoverImageUrl" alt="@Model.FeaturedArticle.Title" />
                        <div class="premium-hero-overlay"></div>
                    </a>
                    <div class="premium-hero-content">
                        <div class="premium-hero-meta">
                            <a class="premium-hero-category" asp-controller="Sections" asp-action="Show" asp-route-slug="@Model.FeaturedArticle.CategorySlug">@Model.FeaturedArticle.CategoryName</a>
                        </div>
                        <h1 class="premium-hero-title">
                            <a asp-controller="Home" asp-action="Show" asp-route-id="@Model.FeaturedArticle.Id">@Model.FeaturedArticle.Title</a>
                        </h1>
                        <p class="premium-hero-summary">@Model.FeaturedArticle.Summary</p>
                        <div class="premium-hero-footer">
                            <div class="premium-hero-author">
                                <span>@Model.FeaturedArticle.AuthorName</span>
                            </div>
                            <div class="premium-hero-details">
                                <span>@Model.FeaturedArticle.CreatedAt.ToString("dd.MM.yyyy")</span>
                                <span class="dot-separator">•</span>
                                <span>@Model.FeaturedArticle.ReadTimeMinutes min lexim</span>
                            </div>
                        </div>
                    </div>
                </article>

                <div class="headline-stack">
                    @foreach (var article in Model.HeadlineArticles)
                    {
                        <partial name="Partials/_ArticleMini" model="article" />
                    }
                </div>
            </section>
        }

        <section class="content-section">
            <div class="section-heading">
                <div>
                    <span class="eyebrow">Te fundit</span>
                    <h2>Rrjedha editoriale e dites</h2>
                </div>
                <a class="text-link" asp-controller="Home" asp-action="Search">Kerko arkiven</a>
            </div>
            <div class="editorial-grid">
                @foreach (var article in Model.LatestArticles)
                {
                    <partial name="Partials/_Article" model="article" />
                }
            </div>
        </section>

        @if (Model.Sections.Any())
        {
            <section class="content-section showcase-section">
                <div class="section-heading">
                    <div>
                        <span class="eyebrow">Kategoritë</span>
                        <h2>Faqe tematike me hyrje të unifikuar</h2>
                    </div>
                </div>

                <div class="section-showcase-grid">
                    @foreach (var sectionPreview in Model.Sections)
                    {
                        <article class="section-card" style="--section-accent:@(sectionPreview.AccentColor)">
                            <div class="section-card-head">
                                <div class="section-card-title-group">
                                    <span class="section-badge" style="background:@sectionPreview.AccentColor"></span>
                                    <h3>@sectionPreview.Title</h3>
                                </div>
                                <a class="section-link" asp-controller="Sections" asp-action="Show" asp-route-slug="@sectionPreview.Slug">
                                    Të gjitha
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                                </a>
                            </div>
                            <p class="section-card-desc">@sectionPreview.Description</p>

                            @if (sectionPreview.Articles.Any())
                            {
                                var topArticle = sectionPreview.Articles.First();
                                var subArticles = sectionPreview.Articles.Skip(1).Take(3).ToList();

                                <div class="section-card-hero">
                                    <a class="section-card-hero-media" asp-controller="Home" asp-action="Show" asp-route-id="@topArticle.Id">
                                        <img src="@topArticle.CoverImageUrl" alt="@topArticle.Title" />
                                    </a>
                                    <div class="section-card-hero-body">
                                        <h4 class="section-card-hero-title">
                                            <a asp-controller="Home" asp-action="Show" asp-route-id="@topArticle.Id">@topArticle.Title</a>
                                        </h4>
                                        <span class="section-card-hero-meta">@topArticle.CreatedAt.ToString("dd.MM.yyyy") • @topArticle.ReadTimeMinutes min</span>
                                    </div>
                                </div>

                                @if (subArticles.Any())
                                {
                                    <ul class="section-card-list">
                                        @foreach (var article in subArticles)
                                        {
                                            <li>
                                                <a asp-controller="Home" asp-action="Show" asp-route-id="@article.Id">@article.Title</a>
                                            </li>
                                        }
                                    </ul>
                                }
                            }
                        </article>
                    }
                </div>
            </section>
        }
    </div>
</div>

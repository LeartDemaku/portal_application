@model PortalHomeViewModel
@{
    ViewData["Title"] = "Ballina";

    // Titujt për shiritin e lajmeve: lajmi kryesor + titujt + të fundit
    var tickerArticles = new[] { Model.FeaturedArticle }
        .Concat(Model.HeadlineArticles)
        .Concat(Model.LatestArticles)
        .Where(article => article != null)
        .Select(article => article!)
        .Take(10)
        .ToList();

    if (Model.FeaturedArticle != null)
    {
        ViewData["OgImage"] = Model.FeaturedArticle.CoverImageUrl;
    }
}

<div class="page">
    <div class="container">
        @if (tickerArticles.Any())
        {
            <section class="ticker" aria-label="Lajmet e fundit">
                <span class="ticker-label"><span class="live-dot" aria-hidden="true"></span><span class="ticker-label-text">Të fundit</span></span>
                <div class="ticker-viewport">
                    <div class="ticker-track" data-ticker>
                        <ul>
                            @foreach (var article in tickerArticles)
                            {
                                <li><a asp-controller="Home" asp-action="Show" asp-route-id="@article.Id">@article.Title</a></li>
                            }
                        </ul>
                    </div>
                </div>
            </section>
        }

        @if (Model.FeaturedArticle != null)
        {
            var featured = Model.FeaturedArticle;
            var featuredAccent = PortalApp.Services.PortalSectionRegistry.Resolve(featured.CategoryName).AccentColor;

            <section class="hero" aria-label="Lajmet kryesore">
                <article class="hero-main" style="--accent:@featuredAccent">
                    <div class="hero-main-media">
                        <img src="@featured.CoverImageUrl" alt="" fetchpriority="high" decoding="async" />
                    </div>
                    <div class="hero-main-body">
                        <div>
                            <a class="chip chip-solid" asp-controller="Sections" asp-action="Show" asp-route-slug="@featured.CategorySlug">@featured.CategoryName</a>
                        </div>
                        <h1 class="hero-main-title">
                            <a asp-controller="Home" asp-action="Show" asp-route-id="@featured.Id">@featured.Title</a>
                        </h1>
                        <p class="hero-main-summary">@featured.Summary</p>
                        <div class="meta">
                            <strong>@featured.AuthorName</strong>
                            <time class="meta-dot" datetime="@featured.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ss")" data-relative>@featured.CreatedAt.ToString("dd.MM.yyyy")</time>
                            <span class="meta-dot">@featured.ReadTimeMinutes min lexim</span>
                        </div>
                    </div>
                </article>

                @if (Model.HeadlineArticles.Any())
                {
                    <div class="hero-side">
                        @foreach (var article in Model.HeadlineArticles)
                        {
                            <partial name="Partials/_ArticleMini" model="article" />
                        }
                    </div>
                }
            </section>
        }

        @if (Model.LatestArticles.Any())
        {
            <section class="section" aria-labelledby="latest-title">
                <div class="section-head">
                    <div>
                        <span class="eyebrow">Të fundit</span>
                        <h2 id="latest-title">Rrjedha editoriale e ditës</h2>
                    </div>
                    <a class="text-link" asp-controller="Home" asp-action="Search">
                        Kërko në arkivë <svg class="icon icon-sm"><use href="#i-arrow-right" /></svg>
                    </a>
                </div>
                <div class="story-grid">
                    @for (var i = 0; i < Model.LatestArticles.Count; i++)
                    {
                        // Karta e parë del më e madhe për të krijuar ritëm vizual
                        <partial name="Partials/_Article" model="Model.LatestArticles[i]" view-data='new ViewDataDictionary(ViewData) { { "Wide", i == 0 } }' />
                    }
                </div>
            </section>
        }

        @if (Model.Sections.Any())
        {
            <section class="section" aria-labelledby="topics-title">
                <div class="section-head">
                    <div>
                        <span class="eyebrow">Kategoritë</span>
                        <h2 id="topics-title">Çdo temë, në një vend</h2>
                    </div>
                </div>

                <div class="topic-grid">
                    @foreach (var sectionPreview in Model.Sections)
                    {
                        <article class="topic-card" style="--accent:@sectionPreview.AccentColor" data-reveal>
                            <div class="topic-card-head">
                                <h3 class="topic-card-title">@sectionPreview.Title</h3>
                                <a class="text-link" asp-controller="Sections" asp-action="Show" asp-route-slug="@sectionPreview.Slug" aria-label="Të gjitha lajmet nga @sectionPreview.Title">
                                    Të gjitha <svg class="icon icon-sm"><use href="#i-arrow-right" /></svg>
                                </a>
                            </div>
                            <p class="topic-card-desc">@sectionPreview.Description</p>

                            @if (sectionPreview.Articles.Any())
                            {
                                var topArticle = sectionPreview.Articles.First();
                                var subArticles = sectionPreview.Articles.Skip(1).Take(3).ToList();

                                <div class="topic-lead">
                                    <div class="topic-lead-media">
                                        <img src="@topArticle.CoverImageUrl" alt="" loading="lazy" decoding="async" />
                                    </div>
                                    <h4 class="topic-lead-title">
                                        <a asp-controller="Home" asp-action="Show" asp-route-id="@topArticle.Id">@topArticle.Title</a>
                                    </h4>
                                    <div class="meta">
                                        <time datetime="@topArticle.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ss")" data-relative>@topArticle.CreatedAt.ToString("dd.MM.yyyy")</time>
                                        <span class="meta-dot">@topArticle.ReadTimeMinutes min lexim</span>
                                    </div>
                                </div>

                                @if (subArticles.Any())
                                {
                                    <ol class="topic-list">
                                        @foreach (var article in subArticles)
                                        {
                                            <li><a asp-controller="Home" asp-action="Show" asp-route-id="@article.Id">@article.Title</a></li>
                                        }
                                    </ol>
                                }
                            }
                        </article>
                    }
                </div>
            </section>
        }

        @if (Model.FeaturedArticle == null)
        {
            <section class="empty-state">
                <span class="empty-state-icon"><svg class="icon"><use href="#i-inbox" /></svg></span>
                <h2>Ende nuk ka lajme të publikuara</h2>
                <p>Sapo redaksia të publikojë artikujt e parë, ata do të shfaqen këtu.</p>
            </section>
        }
    </div>
</div>

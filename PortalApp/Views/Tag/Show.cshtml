@model PortalListingPageViewModel
@{
    ViewData["Title"] = Model.Title;
    ViewData["Description"] = Model.Description;
    if (Model.FeaturedArticle != null)
    {
        ViewData["OgImage"] = Model.FeaturedArticle.CoverImageUrl;
    }
}

<div class="page">
    <div class="container">
        <partial name="~/Views/Shared/Partials/_PortalListing.cshtml" model="Model" />
    </div>
</div>
